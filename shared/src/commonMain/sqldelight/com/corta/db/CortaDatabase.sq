import kotlin.Boolean;

-- SQLCipher Setup
CREATE TABLE Contact (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    phoneNumber TEXT NOT NULL UNIQUE
);

CREATE TABLE FilterRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    pattern TEXT NOT NULL,
    action TEXT NOT NULL, -- "WARN", "MUTE", "BLOCK", "ALLOW"
    isRegex INTEGER AS Boolean DEFAULT 0,
    alias TEXT,
    source TEXT NOT NULL DEFAULT 'USER', -- 'SUBTEL' or 'USER'
    UNIQUE(pattern, source)
);

CREATE TABLE CallLogEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    phoneNumber TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    actionTaken TEXT NOT NULL, -- "BLOCK", "MUTE", "WARN", "ALLOW"
    duration INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE BlockedSms (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sender TEXT NOT NULL,
    body TEXT NOT NULL,
    timestamp INTEGER NOT NULL
);

CREATE TABLE SmsLogEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sender TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    actionTaken TEXT NOT NULL, -- "BLOCK", "MUTE", "WARN", "ALLOW"
    bodyPreview TEXT NOT NULL
);

CREATE TABLE CommunityReport (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    phoneNumber TEXT NOT NULL,
    channel TEXT NOT NULL, -- "CALL" | "SMS"
    reason TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    syncState TEXT NOT NULL DEFAULT 'PENDING' -- "PENDING" | "SYNCED" | "FAILED"
);

CREATE TABLE SpamKeyword (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    keyword TEXT NOT NULL UNIQUE,
    category TEXT NOT NULL DEFAULT 'GENERAL', -- 'BANCO', 'PRESTAMO', 'ESTAFA', 'GENERAL'
    isActive INTEGER AS Boolean DEFAULT 1,
    createdAt INTEGER NOT NULL
);

CREATE TABLE ArchivedConversation (
    threadId INTEGER NOT NULL PRIMARY KEY,
    address TEXT NOT NULL,
    archivedAt INTEGER NOT NULL
);

CREATE TABLE TrashItem (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    itemType TEXT NOT NULL, -- 'CALL' or 'SMS'
    originalId TEXT NOT NULL,
    senderOrNumber TEXT NOT NULL,
    contentPreview TEXT,
    deletedAt INTEGER NOT NULL
);

CREATE TABLE ContactGroup (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    iconName TEXT NOT NULL DEFAULT 'Group',
    colorHex TEXT NOT NULL DEFAULT '#1976D2'
);

CREATE TABLE ContactGroupMember (
    contactId TEXT NOT NULL,
    groupId INTEGER NOT NULL,
    PRIMARY KEY (contactId, groupId)
);

-- Indexes: cover the queries that scan by timestamp DESC (call/SMS logs)
-- and the pending-reports sweep that filters by syncState. These turn
-- the three most expensive reads into cheap index lookups without
-- changing the .sq queries themselves.

CREATE INDEX idx_call_log_timestamp ON CallLogEntry(timestamp DESC);
CREATE INDEX idx_blocked_sms_timestamp ON BlockedSms(timestamp DESC);
CREATE INDEX idx_sms_log_timestamp ON SmsLogEntry(timestamp DESC);
CREATE INDEX idx_community_report_sync ON CommunityReport(syncState, createdAt);
CREATE INDEX idx_spam_keyword_active ON SpamKeyword(isActive);
CREATE INDEX idx_trash_deleted_at ON TrashItem(deletedAt DESC);

-- Initial schema setup complete. Subtel rules might be injected by domain logic or migrations.

getContacts:
SELECT * FROM Contact;

getContactByPhone:
SELECT * FROM Contact WHERE phoneNumber = ?;

insertContact:
INSERT OR REPLACE INTO Contact(name, phoneNumber) VALUES (?, ?);

getRules:
SELECT * FROM FilterRule;

insertRule:
INSERT OR REPLACE INTO FilterRule(pattern, action, isRegex, alias, source) VALUES (?, ?, ?, ?, ?);

deleteRule:
DELETE FROM FilterRule WHERE pattern = ?;

deleteRulesBySource:
DELETE FROM FilterRule WHERE source = ?;

getCallLogs:
SELECT * FROM CallLogEntry ORDER BY timestamp DESC;

insertCallLog:
INSERT INTO CallLogEntry(phoneNumber, timestamp, actionTaken, duration) VALUES (?, ?, ?, ?);

getBlockedSms:
SELECT * FROM BlockedSms ORDER BY timestamp DESC;

insertBlockedSms:
INSERT INTO BlockedSms(sender, body, timestamp) VALUES (?, ?, ?);

getSmsLogs:
SELECT * FROM SmsLogEntry ORDER BY timestamp DESC;

insertSmsLog:
INSERT INTO SmsLogEntry(sender, timestamp, actionTaken, bodyPreview) VALUES (?, ?, ?, ?);

insertCommunityReport:
INSERT INTO CommunityReport(phoneNumber, channel, reason, createdAt, syncState) VALUES (?, ?, ?, ?, ?);

getPendingCommunityReports:
SELECT * FROM CommunityReport WHERE syncState = 'PENDING' ORDER BY createdAt ASC;

updateCommunityReportSyncState:
UPDATE CommunityReport SET syncState = ? WHERE id = ?;

-- Spam Keywords
getSpamKeywords:
SELECT * FROM SpamKeyword ORDER BY createdAt DESC;

getActiveSpamKeywords:
SELECT * FROM SpamKeyword WHERE isActive = 1;

insertSpamKeyword:
INSERT OR REPLACE INTO SpamKeyword(keyword, category, isActive, createdAt) VALUES (?, ?, ?, ?);

deleteSpamKeyword:
DELETE FROM SpamKeyword WHERE id = ?;

toggleSpamKeyword:
UPDATE SpamKeyword SET isActive = ? WHERE id = ?;

-- Archived Conversations
getArchivedConversations:
SELECT * FROM ArchivedConversation ORDER BY archivedAt DESC;

isConversationArchived:
SELECT COUNT(*) FROM ArchivedConversation WHERE threadId = ?;

archiveConversation:
INSERT OR REPLACE INTO ArchivedConversation(threadId, address, archivedAt) VALUES (?, ?, ?);

unarchiveConversation:
DELETE FROM ArchivedConversation WHERE threadId = ?;

-- Papelera (Trash items)
getTrashItems:
SELECT * FROM TrashItem ORDER BY deletedAt DESC;

getTrashItemsByType:
SELECT * FROM TrashItem WHERE itemType = ? ORDER BY deletedAt DESC;

insertTrashItem:
INSERT INTO TrashItem(itemType, originalId, senderOrNumber, contentPreview, deletedAt) VALUES (?, ?, ?, ?, ?);

deleteTrashItem:
DELETE FROM TrashItem WHERE id = ?;

clearTrash:
DELETE FROM TrashItem;

clearTrashByType:
DELETE FROM TrashItem WHERE itemType = ?;

-- Contact Groups
getContactGroups:
SELECT * FROM ContactGroup ORDER BY name ASC;

insertContactGroup:
INSERT OR REPLACE INTO ContactGroup(name, iconName, colorHex) VALUES (?, ?, ?);

deleteContactGroup:
DELETE FROM ContactGroup WHERE id = ?;

getGroupMembers:
SELECT contactId FROM ContactGroupMember WHERE groupId = ?;

addContactToGroup:
INSERT OR IGNORE INTO ContactGroupMember(contactId, groupId) VALUES (?, ?);

removeContactFromGroup:
DELETE FROM ContactGroupMember WHERE contactId = ? AND groupId = ?;

getContactGroupsForContact:
SELECT g.* FROM ContactGroup g
INNER JOIN ContactGroupMember m ON g.id = m.groupId
WHERE m.contactId = ?;

