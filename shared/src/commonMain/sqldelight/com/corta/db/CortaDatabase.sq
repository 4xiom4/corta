import kotlin.Boolean;

-- SQLCipher Setup
CREATE TABLE Contact (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    phoneNumber TEXT NOT NULL UNIQUE
);

CREATE TABLE FilterRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    pattern TEXT NOT NULL,
    action TEXT NOT NULL, -- "WARN", "MUTE", "BLOCK", "ALLOW"
    isRegex INTEGER AS Boolean DEFAULT 0,
    alias TEXT,
    source TEXT NOT NULL DEFAULT 'USER', -- 'SUBTEL' or 'USER'
    UNIQUE(pattern, source)
);

CREATE TABLE CallLogEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    phoneNumber TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    actionTaken TEXT NOT NULL, -- "BLOCK", "MUTE", "WARN", "ALLOW"
    duration INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE BlockedSms (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sender TEXT NOT NULL,
    body TEXT NOT NULL,
    timestamp INTEGER NOT NULL
);

CREATE TABLE SmsLogEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sender TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    actionTaken TEXT NOT NULL, -- "BLOCK", "MUTE", "WARN", "ALLOW"
    bodyPreview TEXT NOT NULL
);

CREATE TABLE CommunityReport (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    phoneNumber TEXT NOT NULL,
    channel TEXT NOT NULL, -- "CALL" | "SMS"
    reason TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    syncState TEXT NOT NULL DEFAULT 'PENDING' -- "PENDING" | "SYNCED" | "FAILED"
);

-- Indexes: cover the queries that scan by timestamp DESC (call/SMS logs)
-- and the pending-reports sweep that filters by syncState. These turn
-- the three most expensive reads into cheap index lookups without
-- changing the .sq queries themselves.

CREATE INDEX idx_call_log_timestamp ON CallLogEntry(timestamp DESC);
CREATE INDEX idx_blocked_sms_timestamp ON BlockedSms(timestamp DESC);
CREATE INDEX idx_sms_log_timestamp ON SmsLogEntry(timestamp DESC);
CREATE INDEX idx_community_report_sync ON CommunityReport(syncState, createdAt);

-- Initial schema setup complete. Subtel rules might be injected by domain logic or migrations.

getContacts:
SELECT * FROM Contact;

getContactByPhone:
SELECT * FROM Contact WHERE phoneNumber = ?;

insertContact:
INSERT OR REPLACE INTO Contact(name, phoneNumber) VALUES (?, ?);

getRules:
SELECT * FROM FilterRule;

insertRule:
INSERT OR REPLACE INTO FilterRule(pattern, action, isRegex, alias, source) VALUES (?, ?, ?, ?, ?);

deleteRule:
DELETE FROM FilterRule WHERE pattern = ?;

deleteRulesBySource:
DELETE FROM FilterRule WHERE source = ?;

getCallLogs:
SELECT * FROM CallLogEntry ORDER BY timestamp DESC;

insertCallLog:
INSERT INTO CallLogEntry(phoneNumber, timestamp, actionTaken, duration) VALUES (?, ?, ?, ?);

getBlockedSms:
SELECT * FROM BlockedSms ORDER BY timestamp DESC;

insertBlockedSms:
INSERT INTO BlockedSms(sender, body, timestamp) VALUES (?, ?, ?);

getSmsLogs:
SELECT * FROM SmsLogEntry ORDER BY timestamp DESC;

insertSmsLog:
INSERT INTO SmsLogEntry(sender, timestamp, actionTaken, bodyPreview) VALUES (?, ?, ?, ?);

insertCommunityReport:
INSERT INTO CommunityReport(phoneNumber, channel, reason, createdAt, syncState) VALUES (?, ?, ?, ?, ?);

getPendingCommunityReports:
SELECT * FROM CommunityReport WHERE syncState = 'PENDING' ORDER BY createdAt ASC;

updateCommunityReportSyncState:
UPDATE CommunityReport SET syncState = ? WHERE id = ?;

